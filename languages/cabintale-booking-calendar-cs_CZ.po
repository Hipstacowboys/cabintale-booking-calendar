#: includes/class-settings.php:599
msgid "Makes a new page called “Book now” with your first widget on it, using your theme’s default layout. If you already have a page designed, paste the shortcode into it instead."
msgstr "Vytvoří novou stránku „Rezervovat“ s vaším prvním widgetem, podle výchozího vzhledu vaší šablony. Pokud už máte stránku navrženou, vložte shortcode do ní."

#: includes/class-settings.php:647
msgid "Connected. Your widgets are now available in the Cabintale block."
msgstr "Připojeno. Vaše widgety jsou teď dostupné v bloku Cabintale."

#: includes/class-settings.php:648
msgid "Disconnected. Widgets already on your pages keep working."
msgstr "Odpojeno. Widgety, které už máte na stránkách, dál fungují."

#: includes/class-settings.php:649
msgid "Connection cancelled. Nothing changed."
msgstr "Propojení zrušeno. Nic se nezměnilo."

#: includes/class-settings.php:650
msgid "That connection attempt timed out. Try connecting again."
msgstr "Ten pokus o propojení vypršel. Zkuste se připojit znovu."

#: includes/class-settings.php:651
msgid "That connection could not be verified. Try connecting again."
msgstr "Toto propojení se nepodařilo ověřit. Zkuste se připojit znovu."

#: includes/class-settings.php:652
msgid "Could not reach Cabintale. Check your internet connection and try again."
msgstr "Nepodařilo se spojit s Cabintale. Zkontrolujte internetové připojení a zkuste to znovu."

#: includes/class-settings.php:653
msgid "Cabintale did not accept the connection. Try connecting again."
msgstr "Cabintale propojení nepřijalo. Zkuste se připojit znovu."

#: includes/class-settings.php:654
msgid "Connected, but there are no widgets on your Cabintale account yet. Create one in Cabintale, then refresh this page."
msgstr "Připojeno, ale na vašem účtu Cabintale ještě nejsou žádné widgety. Vytvořte jeden v Cabintale a pak obnovte tuto stránku."

#: includes/class-settings.php:655
msgid "The booking page could not be created. Add the Cabintale block to a page yourself instead."
msgstr "Rezervační stránku se nepodařilo vytvořit. Vložte blok Cabintale na stránku sami."

